RABBITMQ_URL=
# AMQP exchange-naam waarop master agent publishet en consumeert.
# Default = ai.events. Optioneel — als RabbitMQ niet beschikbaar is start de
# server door zonder, met enkel een WARN-log.
RABBITMQ_EXCHANGE=ai.events
TEAMS_ID=
CHANNEL_ID=
TEAMS_TOKEN=

WEBHOOK=
WEBHOOK_TOKEN=

# Multi-server MCP endpoints (preferred). Format: label@url,label@url,...
# Whitespace around items is trimmed; malformed entries are skipped.
#
# Local dev (via SSH-tunnels — see .claude/rules/E2E_SETUP_AND_TROUBLESHOOTING.md):
#   MCP_SERVERS=crm@http://localhost:7001/mcp,controlroom@http://localhost:7002/mcp
#
# Production (intra docker-network DNS):
#   MCP_SERVERS=crm@http://crm:7001/mcp,controlroom@http://controlroom:7002/mcp
MCP_SERVERS=

# Legacy single-server fallback. Only used when MCP_SERVERS is unset or empty.
# MCP_BASE_URL=http://localhost
# MCP_PORT=7001

# Anthropic
ANTHROPIC_API_KEY=

# Optional bearer-auth on POST /chat. If set, requests must send
# `Authorization: Bearer <value>`. Unset/empty = auth-loos (dev-only,
# WARN-logged at startup). /health and /metrics stay unauthenticated.
CHAT_BEARER_TOKEN=

# Strict-CORS toggle. `true` upgrades a missing/invalid CHAT_ALLOWED_ORIGINS
# from "fallback to permissive with WARN" to "fail startup". Production sets
# this `true`; local dev leaves it unset so `cargo run` works without an
# allow-list configured.
CHAT_CORS_STRICT=false
